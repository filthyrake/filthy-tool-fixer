# FilthyLLM Configuration

# Proxy server
FILTHY_HOST=0.0.0.0
FILTHY_PORT=8079

# Primary backend (fast model)
FILTHY_BACKEND_URL=http://localhost:11434
FILTHY_BACKEND_TYPE=ollama

# Escalation backend (quality model)
FILTHY_ESCALATION_BACKEND_URL=http://localhost:11435
FILTHY_ESCALATION_BACKEND_TYPE=ollama

# Timeouts (seconds)
FILTHY_REQUEST_TIMEOUT=45.0
FILTHY_BACKEND_TIMEOUT=120.0
FILTHY_ESCALATION_TIMEOUT=180.0

# Concurrency
FILTHY_MAX_CONCURRENT_TOOL_REQUESTS=3

# Logging
FILTHY_LOG_LEVEL=INFO
FILTHY_LOG_FORMAT=json
